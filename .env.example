# Copy this file to .env and fill it in. Never commit .env or real keys to GitHub.

# Required: your Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Required: password for the admin page at /admin
ADMIN_PASSWORD=

# Recommended: long random text that signs admin logins (e.g. run: openssl rand -hex 32)
SESSION_SECRET=

PORT=3000
# Where bots and conversations are saved. Use a persistent disk in production.
DATA_DIR=./data

# Defaults for bots that don't pick their own model/effort in the admin page
DEFAULT_MODEL=claude-opus-5-5
DEFAULT_EFFORT=low
MAX_TOKENS=2048

# Messages per minute per visitor
RATE_LIMIT_PER_MIN=20
# Set to true behind a proxy/load balancer (Render, Railway, Fly.io, nginx)
TRUST_PROXY=false
# Set to false to stop saving conversations
SAVE_CONVERSATIONS=true
MAX_CONVERSATIONS_PER_BOT=1000
